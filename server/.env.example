# Copy this file to .env and fill in real values.
# Never commit .env to version control.

WEBHOOK_SECRET=your-secret-here
# Local SQLite file. On Render, mount a persistent disk at /var/data or set
# DB_FILE=/var/data/bridge.db so MT5 trade history survives deploys/restarts.
DB_FILE=bridge.db
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-admin-chat-id
TELEGRAM_TRADE_CLEAN_MODE=true
TELEGRAM_DEBUG_TRADE_EVENTS=false
TRADING_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=60
ENABLE_AI_WEB_SEARCH=true
